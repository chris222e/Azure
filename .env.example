# ====================================
# 🔐 Azure Credentials
# ====================================
# IMPORTANTE: Copia este archivo a .env y agrega tus credenciales
# El archivo .env está en .gitignore para proteger tus claves

# Vision API (OCR, Object Detection, Image Analysis)
AZURE_VISION_KEY=tu_clave_aqui
AZURE_VISION_ENDPOINT=https://tu-region.api.cognitive.microsoft.com

# Language API (Entity Recognition)
AZURE_LANGUAGE_KEY=tu_clave_aqui
AZURE_LANGUAGE_ENDPOINT=https://tu-region.api.cognitive.microsoft.com

# OpenAI API (Chat GPT)
AZURE_OPENAI_KEY=tu_clave_aqui
AZURE_OPENAI_ENDPOINT=https://tu-openai.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=nombre-del-deployment
AZURE_OPENAI_VERSION=2025-04-01-preview

# Phi-4 LLM
AZURE_PHI4_KEY=tu_clave_aqui
AZURE_PHI4_ENDPOINT=https://tu-region.api.cognitive.microsoft.com
